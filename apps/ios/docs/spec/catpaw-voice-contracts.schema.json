          "type": "integer",
          "minimum": 0
        },
        "consent_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "type": "string",
          "enum": [
            "capture_started",
            "audio_chunk",
            "input_finished",
            "asr_partial",
            "asr_final",
            "tts_segment",
            "playback_started",
            "playback_ended",
            "interrupted",
            "cancel_ack",
            "stream_error"
          ]
        },
        "payload_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload_storage": {
          "const": "ephemeral_memory_only"
        },
        "codec": {
          "type": "string",
          "enum": [
            "pcm_s16le",
            "pcm_f32le",
            "opus",
            "wav",
            "device_handle",
            "text_event"
          ]
        },
        "sample_rate": {
          "type": "integer",

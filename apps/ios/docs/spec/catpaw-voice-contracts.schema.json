        "created_at",
        "session_id",
        "session_epoch",
        "turn_id",
        "stream_id",
        "direction",
        "seq",
        "capture_epoch",
        "playback_epoch",
        "consent_epoch",
        "event_type",
        "payload_storage",
        "generation_epoch"
      ],
      "additionalProperties": false,
      "description": "Transient wire/event shape; raw payload and audio bytes are not business-log records. Persist only redacted metrics where permitted.",
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "tts_segment"
              }
            }
          },
          "then": {
            "required": [
              "segment_id",
              "segment_index",
              "text_hash",
              "payload_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "audio_chunk"
              }
            }
          },
          "then": {
            "required": [
              "payload_ref",
              "codec",
              "sample_rate",
              "channels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "stream_error"
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ]
          }
        }
      ]
    },
    "VoiceControl": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "record_type": {
          "const": "voice_control"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_session_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "expected_capture_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "expected_playback_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "expected_generation_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "string",
          "enum": [
            "finish_utterance",
            "abort_capture",
            "stop_playback",
            "interrupt_turn",
            "end_session",
            "system_interrupt",
            "resume_session"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "user_interface",
            "authenticated_voice",
            "system_event"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "user_requested",
            "background",
            "lock",
            "incoming_call",
            "audio_focus_loss",
            "route_changed",
            "permission_revoked",
            "network_lost"
          ]
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "id",
        "created_at",
        "session_id",
        "expected_session_epoch",
        "expected_capture_epoch",
        "expected_playback_epoch",
        "expected_generation_epoch",
        "command",
        "source",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "resume_session"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "user_interface"
              },
              "reason": {
                "const": "user_requested"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "system_interrupt"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "system_event"
              },
              "reason": {
                "not": {
                  "const": "user_requested"
                }
              }
            }
          }
        }
      ]
    }
  }

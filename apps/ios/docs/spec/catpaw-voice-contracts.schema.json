          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "direction": {
          "type": "string",
          "enum": [

          "maximum": 2
        },
        "segment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "segment_index": {
          "type": "integer",
          "minimum": 0
        },
        "text_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation_epoch": {
          "type": "integer",
          "minimum": 0
        }

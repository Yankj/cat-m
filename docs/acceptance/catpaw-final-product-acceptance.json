      "local_decision_feedback_p95_ms": 500,
      "valid_card_to_render_p95_ms": 250,
      "readonly_restore_start_max_seconds": 5,
      "short_reply_first_text_p95_seconds": 10,
      "short_reply_complete_p95_seconds": 60,
      "local_samples_per_metric_minimum": 30,
      "real_short_reply_samples_minimum": 20,
      "percentile_method": "nearest_rank",
      "include_failures_and_timeouts": true
    },
    "daily_use": {
